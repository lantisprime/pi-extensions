{
	// The WHOLE extension: index.ts + every lib module. 0 errors as of 2026-10-03.
	// Two batches were cleared in sequence — the 32-error lib/ backlog, then the
	// 27-error index.ts batch (mostly custom fields this extension attaches to the
	// host ExtensionContext, now declared in lib/pi-context-augmentation.d.ts).
	// Wired into CI so neither can return.
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"allowImportingTsExtensions": true,
		"baseUrl": ".",
		"paths": {
			"@earendil-works/pi-coding-agent": [
				"./node_modules/@earendil-works/pi-coding-agent/dist/index.d.ts"
			]
		}
	},
	"include": [
		"index.ts",
		"lib/**/*.ts"
	]
}